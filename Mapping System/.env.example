# -----------------------------------------------------------------------------
# TRETA MAPPING SYSTEM - ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# Port on which the standalone Mapping System runs (default 3001)
PORT=3001

# Public URL of the Mapping System
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Path to the SQLite railway database (relative or absolute)
# Default is ./data/treta_railway.db inside the Mapping System root
DATABASE_PATH=./data/treta_railway.db

# Host header / CORS allowed origin for external web dashboards (e.g. http://localhost:3000)
ALLOWED_ORIGIN=*

# RAILRADAR API CREDENTIALS & LIVE TRACKING (Optional)
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_API_URL=https://api.railradar.in/v1
